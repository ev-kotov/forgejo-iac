[Unit]
Description=Forgejo Database service
Requires=forgejo-internal-network.service
After=forgejo-internal-network.service

[Container]
ContainerName=forgejo-db
Image=docker.io/library/postgres:17-alpine
EnvironmentFile=%h/projects/forgejo-iac/forgejo.env
Volume=/srv/forgejo-data/db:/var/lib/postgresql/data:Z,U

Network=forgejo-internal.network

[Service]
Restart=always

[Install]
WantedBy=default.target