# Db
FORGEJO__database__DB_TYPE=postgres

POSTGRES_USER=forgejo
FORGEJO__database__USER=forgejo

FORGEJO__database__PASSWD=
POSTGRES_PASSWORD=

FORGEJO__database__HOST=forgejo-db:5432

POSTGRES_DB=forgejo
FORGEJO__database__NAME=forgejo

# Forgejo
FORGEJO__server__ROOT_URL=
FORGEJO__server__DOMAIN=127.0.0.1
FORGEJO__server__SSH_DOMAIN=127.0.0.1
FORGEJO__server__SSH_PORT=2224
FORGEJO__server__SSH_LISTEN_PORT=
FORGEJO__server__START_SSH_SERVER=true
FORGEJO__server__DISABLE_SSH=false

# Cache (twoqueue, without spase in JSON)
FORGEJO__cache__ADAPTER=twoqueue
FORGEJO__cache__HOST={"size":100,"recent_ratio":0.25,"ghost_ratio":0.5}

# Actions
FORGEJO__actions__ENABLED=true

# === Security ===
# temp false for deploy — set true after deploy
FORGEJO__security__INSTALL_LOCK=false
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__REQUIRE_SIGNIN_VIEW=true